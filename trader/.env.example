# Copy to .env and edit before running.
# The bot refuses to place real trades until LIVE_TRADING=true.
LIVE_TRADING=false

# Hard circuit breaker: bot halts all trading (and exits) once cumulative
# REALIZED losses reach this many US dollars. This is the "never lose more
# than $2" safety limit. Keep it small.
MAX_TOTAL_LOSS_USD=2

# Size of each buy, in SOL. Keep this small relative to MAX_TOTAL_LOSS_USD --
# a couple of full losses at this size should not exceed the cap by much.
PER_TRADE_SOL=0.02

# Exit rules for every open position.
TAKE_PROFIT_PCT=50
STOP_LOSS_PCT=25

# Max number of positions open at once.
MAX_OPEN_POSITIONS=2

# How often to scan for new tokens / re-check open positions, in seconds.
POLL_INTERVAL_SECONDS=30

# Only consider bonding-curve tokens with at least this much progress toward
# graduation (0-100) and this much SOL raised, as a very crude "not obviously
# dead on arrival" filter. Tune freely -- this is a simplistic default
# strategy, not investment advice.
MIN_PROGRESS_PCT=5
MAX_PROGRESS_PCT=80

# Optional: comma-separated keyword filter on token name/symbol. Leave empty
# to consider all new listings.
NAME_KEYWORDS=

# Optional: comma-separated mint addresses. If set, the bot ONLY trades these
# mints (fixed watchlist mode) instead of scanning new listings.
WATCHLIST_MINTS=
